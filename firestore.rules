rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isOwner() {
      return isVerified() && resource.data.userId == request.auth.uid;
    }
    function isOwnerCreate() {
      return isVerified() && request.resource.data.userId == request.auth.uid;
    }
    function ownerIsUnchanged() {
      return isOwner() && request.resource.data.userId == resource.data.userId;
    }
    match /quotes/{document} {
      allow create: if isOwnerCreate();
      allow read, delete: if isOwner();
      allow update: if ownerIsUnchanged();
    }
    match /collections/{document} {
      allow create: if isOwnerCreate();
      allow read, delete: if isOwner();
      allow update: if ownerIsUnchanged();
    }
    match /topics/{document} {
      allow create: if isOwnerCreate();
      allow read, delete: if isOwner();
      allow update: if ownerIsUnchanged();
    }
    match /insights/{document} {
      allow create: if isOwnerCreate();
      allow read, delete: if isOwner();
      allow update: if ownerIsUnchanged();
    }
    match /knowledge_entries/{document} {
      allow create: if isOwnerCreate();
      allow read, delete: if isOwner();
      allow update: if ownerIsUnchanged();
    }
  }
}
